# Local development can use SQLite. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://pulseready:pulseready@localhost:5432/pulseready
DATABASE_URL=sqlite:///./pulseready.db

# JSON object mapping API keys to tenant UUIDs. Replace these values.
PULSEREADY_API_KEYS={"demo-key-change-me":"11111111-1111-4111-8111-111111111111"}

# Upload and freshness guardrails
MAX_UPLOAD_BYTES=2000000
MAX_SIGNAL_AGE_HOURS=72
MAX_FUTURE_SKEW_MINUTES=10

# Explicit local browser origins only; do not use '*'.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Synthetic/demo data only. Do not use patient-identifiable data.

# Optional external integration slots. These are disabled unless their name is
# explicitly listed in ENABLED_INTEGRATIONS. Provider URLs and credentials have
# not been verified by this repository; replace placeholders only after review.
EXTERNAL_HTTP_TIMEOUT_SECONDS=10
ENABLED_INTEGRATIONS=
# Offline mode is mandatory by default. Live mode additionally requires
# INTEGRATIONS_ENABLED=true and service-specific validated credentials.
INTEGRATION_MODE=mock
INTEGRATIONS_ENABLED=false
ADAPTION_ENABLED=false

AGENT37_CLOUD_API_KEY=YOUR_API_KEY_HERE
AGENT37_CLOUD_ENDPOINT=YOUR_ENDPOINT_URL_HERE
AGENT37_PERSONAL_API_KEY=YOUR_API_KEY_HERE
AGENT37_PERSONAL_ENDPOINT=YOUR_ENDPOINT_URL_HERE
ADAPTION_LABS_API_KEY=YOUR_API_KEY_HERE
ADAPTION_LABS_ENDPOINT=YOUR_ENDPOINT_URL_HERE
RENDER_API_TOKEN=YOUR_API_TOKEN_HERE
RENDER_API_ENDPOINT=YOUR_ENDPOINT_URL_HERE
NODUS_COMPUTE_API_KEY=YOUR_API_KEY_HERE
NODUS_COMPUTE_ENDPOINT=YOUR_ENDPOINT_URL_HERE
ELEVENLABS_API_KEY=YOUR_API_KEY_HERE
ELEVENLABS_API_ENDPOINT=YOUR_ENDPOINT_URL_HERE
ELEVENLABS_VOICE_ID=YOUR_VOICE_ID_HERE
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
BROWSER_USE_API_KEY=YOUR_API_KEY_HERE
BROWSER_USE_ENDPOINT=YOUR_ENDPOINT_URL_HERE
FLUTTERFLOW_API_KEY=YOUR_API_KEY_HERE
FLUTTERFLOW_ENDPOINT=YOUR_ENDPOINT_URL_HERE
